{
  "name": "xiaodai-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.mjs",
  "description": "小呆 Companion：可自訂行為的 ChatGPT companion panel 與 Windows 透明桌面寵物。",
  "author": "Xrelifen",
  "license": "MIT",
  "homepage": "https://github.com/Xrelifen/xiaodai-companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xrelifen/xiaodai-companion.git"
  },
  "scripts": {
    "build:plugin": "node scripts/sync-pet-catalog.mjs && node scripts/build-plugin.mjs",
    "check": "npm run build:plugin && node scripts/validate-project.mjs && npm test",
    "desktop": "npm run sync:pets && electron src/desktop/main.mjs",
    "dist:windows": "electron-builder --win nsis portable --publish never",
    "preview": "node scripts/preview-server.mjs",
    "sync:pets": "node scripts/sync-pet-catalog.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "tw.xiaodai.companion",
    "productName": "小呆 Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/core/**/*",
      "src/desktop/**/*",
      "src/ui/**/*",
      "assets/**/*",
      "!assets/pets/*/source/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Xiaodai-Companion-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Xiaodai-Companion-Portable-${version}-${arch}.${ext}"
    }
  }
}

